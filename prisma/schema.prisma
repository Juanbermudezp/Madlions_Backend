// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Roles del sistema (Módulo 0). Solo se aceptan estos cuatro valores.
enum Rol {
  MIEMBRO
  ENTRENADOR
  RECEPCION
  ADMINISTRADOR

  @@map("rol")
}

enum EstadoBloque {
  DISPONIBLE
  OCUPADO

  @@map("estado_bloque")
}

enum EstadoClase {
  PROGRAMADA
  CANCELADA_GIMNASIO

  @@map("estado_clase")
}

/// Estado de una reserva de clase (H5). Los dos estados de cancelación son
/// finales: CANCELADA_MIEMBRO la pone H6 y CANCELADA_GIMNASIO la pone H7.
enum EstadoReserva {
  CONFIRMADA
  CANCELADA_MIEMBRO
  CANCELADA_GIMNASIO

  @@map("estado_reserva")
}

/// Asistencia a una reserva; la registra el entrenador en H19. Tiene los mismos
/// valores que la asistencia de las sesiones personales (H9), pero es un enum
/// propio para que H5 y H9 no se pisen en el schema.
enum AsistenciaReserva {
  SIN_REGISTRAR
  ASISTIO
  NO_ASISTIO

  @@map("asistencia_reserva")
}

/// Módulo que genera un aviso (Módulo 9). SESIONES y PAGOS quedan disponibles
/// para avisos futuros.
enum ModuloOrigen {
  MEMBRESIAS
  CLASES
  SESIONES
  PAGOS

  @@map("modulo_origen")
}

/// Estado de lectura de un aviso: el servicio lo crea NO_LEIDO y pasa a LEIDO
/// cuando el miembro lo abre o marca todos como leídos (H23).
enum EstadoAviso {
  NO_LEIDO
  LEIDO

  @@map("estado_aviso")
}

/// Cuenta de acceso de cualquier persona del sistema.
///
/// Las restricciones que Prisma no puede expresar (largo mínimo del nombre y
/// del apellido, formato del teléfono) viven como CHECK en la migración.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String   @db.VarChar(50)
  apellido     String   @db.VarChar(50)
  telefono     String   @db.Char(8)
  rol          Rol      @default(MIEMBRO)
  isActive     Boolean  @default(true) @map("activo")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  miembro       Miembro?
  bloquesDisponibilidad BloqueDisponibilidad[]
  clases                Clase[]
  membresiasRegistradas Membresia[]
  sesionesPersonales    SesionPersonal[]
  @@map("usuario")
}

/// Ficha de un miembro del gimnasio. Cada ficha pertenece a un único usuario.
///
/// `codigoMiembro` lo genera el servidor a partir de la secuencia
/// `miembro_codigo_seq` (MBR-000001, MBR-000002, ...). Los formatos del DUI y
/// del código se validan con CHECK en la migración.
model Miembro {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  documento     String   @unique @db.Char(10)
  codigoMiembro String   @unique @map("codigo_miembro") @db.Char(10)
  createdAt     DateTime @default(now()) @map("created_at")
  registrosProgreso RegistroProgreso[] 

    avisos Aviso[]
  membresias Membresia[]
  cobros Cobro[]
  sesionesPersonales SesionPersonal[]
  reservas Reserva[]

  @@map("miembro")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model BloqueDisponibilidad {
  id           String       @id @default(uuid()) @db.Uuid
  entrenadorId String       @map("entrenador_id") @db.Uuid
  entrenador   User         @relation(fields: [entrenadorId], references: [id])
  inicio       DateTime
  fin          DateTime
  duracionMin  Int          @map("duracion_min")
  estado       EstadoBloque @default(DISPONIBLE)
  creadoEn     DateTime     @default(now()) @map("creado_en")
  sesion       SesionPersonal?

  @@index([entrenadorId, inicio])
  @@map("bloque_disponibilidad")
}

/// Catálogo de tipos de clase grupal (Yoga, Spinning, Crossfit...). Lo
/// administra el administrador (H4) y lo usan los planes (H1).
///
/// El largo mínimo del nombre (2 caracteres) vive como CHECK en la migración.
model TipoClase {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @unique @db.VarChar(40)
  descripcion String   @db.VarChar(300)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  clases Clase[]
  planes PlanTipoClase[]
  membresias MembresiaTipoClase[]

  @@map("tipo_clase")
}

/// Clase grupal programada (H4). La creó H8 en su forma mínima para validar
/// traslapes y H4 la amplía. Los CHECK de horario (fin > inicio) y de cupo
/// (1 a 50) viven en las migraciones.
model Clase {
  id           String      @id @default(uuid()) @db.Uuid
  tipoClaseId  String      @map("tipo_clase_id") @db.Uuid
  tipoClase    TipoClase   @relation(fields: [tipoClaseId], references: [id])
  entrenadorId String      @map("entrenador_id") @db.Uuid
  entrenador   User        @relation(fields: [entrenadorId], references: [id])
  descripcion  String?     @db.VarChar(300)
  inicio       DateTime
  fin          DateTime
  cupoMaximo   Int         @map("cupo_maximo")
  estado       EstadoClase @default(PROGRAMADA)
  creadoEn     DateTime    @default(now()) @map("creado_en")

  reservas Reserva[]

  @@index([entrenadorId, inicio])
  @@index([inicio])
  @@map("clase")
}

/// Aviso de un miembro (Módulo 9, H22). Lo registra únicamente AvisosService;
/// no hay endpoint para crearlos.
///
/// Deduplicación: el índice único (miembro_id, referencia) impide repetir un
/// aviso con la misma referencia para el mismo miembro. Los avisos sin
/// referencia (NULL) no chocan entre sí, porque PostgreSQL trata cada NULL como
/// distinto en un índice único: se comporta como el índice parcial que pide
/// DB-22.1 sin necesitar la preview `partialIndexes`.
///
/// Las restricciones que Prisma no puede expresar (título y mensaje no vacíos,
/// estado coherente con leido_en) viven como CHECK en la migración.
model Aviso {
  id           String       @id @default(uuid()) @db.Uuid
  miembroId    String       @map("miembro_id") @db.Uuid
  miembro      Miembro      @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  titulo       String       @db.VarChar(100)
  mensaje      String       @db.VarChar(500)
  moduloOrigen ModuloOrigen @map("modulo_origen")
  referencia   String?      @db.VarChar(100)
  estado       EstadoAviso  @default(NO_LEIDO)
  creadoEn     DateTime     @default(now()) @map("creado_en")
  leidoEn      DateTime?    @map("leido_en")

  @@unique([miembroId, referencia])
  @@index([miembroId, creadoEn])
  @@index([miembroId, estado])
  @@map("aviso")
}


enum TipoProgreso {
  PESO
  CINTURA
  CADERA
  PECHO
  BRAZO
  MUSLO
  MARCA

  @@map("tipo_progreso")
}

model RegistroProgreso {
  id           String       @id @default(uuid()) @db.Uuid
  miembroId    String       @map("miembro_id") @db.Uuid
  miembro      Miembro      @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  fecha        DateTime     @db.Date
  tipo         TipoProgreso
  valor        Decimal      @db.Decimal(5, 1)
  ejercicio    String?      @db.VarChar(60)
  repeticiones Int?
  creadoEn     DateTime     @default(now()) @map("creado_en")

  @@index([miembroId, fecha])
  @@map("registro_progreso")
}

/// Tipos de plan que vende el gimnasio (H1).
enum TipoPlan {
  DAYPASS
  MENSUAL
  SET_CLASES

  @@map("tipo_plan")
}

/// Plan que vende el gimnasio (H1).
///
/// Las restricciones que Prisma no puede expresar viven como CHECK en la
/// migración: precio mayor que 0, cantidad_clases entre 1 y 100 solo en
/// SET_CLASES (nula en los demás) y duracion_dias de 1 en DAYPASS y 30 en los
/// demás.
model Plan {
  id             String   @id @default(uuid()) @db.Uuid
  nombre         String   @unique @db.VarChar(60)
  tipo           TipoPlan
  precio         Decimal  @db.Decimal(10, 2)
  cantidadClases Int?     @map("cantidad_clases")
  duracionDias   Int      @map("duracion_dias")
  beneficios     String   @db.VarChar(500)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  tiposClase PlanTipoClase[]
  membresias Membresia[]

  @@map("plan")
}

/// Tipos de clase que incluye un plan (H1).
model PlanTipoClase {
  planId      String    @map("plan_id") @db.Uuid
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  tipoClaseId String    @map("tipo_clase_id") @db.Uuid
  tipoClase   TipoClase @relation(fields: [tipoClaseId], references: [id])

  @@id([planId, tipoClaseId])
  @@map("plan_tipo_clase")
}

/// Parámetros generales del sistema como pares clave-valor (H1). La migración
/// carga la fila inicial precio_clase_puntual = 10.00.
model Configuracion {
  clave         String   @id @db.VarChar(50)
  valor         String   @db.VarChar(100)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("configuracion")
}

enum EstadoSesion {
  AGENDADA

  @@map("estado_sesion")
}

enum AsistenciaSesion {
  SIN_REGISTRAR
  ASISTIO
  NO_ASISTIO

  @@map("asistencia_sesion")
}

model SesionPersonal {
  id           String               @id @default(uuid()) @db.Uuid
  bloqueId     String               @unique @map("bloque_id") @db.Uuid
  bloque       BloqueDisponibilidad @relation(fields: [bloqueId], references: [id])
  miembroId    String               @map("miembro_id") @db.Uuid
  miembro      Miembro              @relation(fields: [miembroId], references: [id])
  entrenadorId String               @map("entrenador_id") @db.Uuid
  entrenador   User                 @relation(fields: [entrenadorId], references: [id])
  inicio       DateTime
  fin          DateTime
  precio       Decimal              @db.Decimal(10, 2)
  cobroId      String?              @unique @map("cobro_id") @db.Uuid
  cobro        Cobro?               @relation(fields: [cobroId], references: [id], onDelete: Restrict)
  estado       EstadoSesion         @default(AGENDADA)
  asistencia   AsistenciaSesion     @default(SIN_REGISTRAR)
  creadaEn     DateTime             @default(now()) @map("creada_en")

  @@index([miembroId, inicio])
  @@index([entrenadorId, inicio])
  @@map("sesion_personal")
}
/// Operación con la que se registró una membresía (H2).
enum TipoOperacionMembresia {
  COMPRA
  RENOVACION

  @@map("tipo_operacion_membresia")
}

/// Estado de pago de una membresía (H2). Las fechas de vigencia se fijan al
/// pasar a PAGADA.
enum EstadoMembresia {
  PENDIENTE_PAGO
  PAGADA

  @@map("estado_membresia")
}

/// Membresía comprada o renovada por un miembro (H2).
///
/// Guarda una copia de las condiciones del plan al momento de la compra
/// (nombre, tipo, precio, cantidad de clases y tipos de clase), así editar o
/// desactivar el plan (H1) no la altera.
///
/// Viven como CHECK o índice en la migración: precio mayor que 0,
/// cantidad_clases según el tipo de plan, fechas de vigencia nulas hasta el
/// pago, una renovación siempre apunta a la membresía anterior, y el índice
/// único parcial que permite una sola membresía PENDIENTE_PAGO por miembro.
model Membresia {
  id                    String                 @id @default(uuid()) @db.Uuid
  miembroId             String                 @map("miembro_id") @db.Uuid
  miembro               Miembro                @relation(fields: [miembroId], references: [id])
  planId                String                 @map("plan_id") @db.Uuid
  plan                  Plan                   @relation(fields: [planId], references: [id])
  nombrePlan            String                 @map("nombre_plan") @db.VarChar(60)
  tipoPlan              TipoPlan               @map("tipo_plan")
  precio                Decimal                @db.Decimal(10, 2)
  cantidadClases        Int?                   @map("cantidad_clases")
  tipoOperacion         TipoOperacionMembresia @map("tipo_operacion")
  membresiaAnteriorId   String?                @map("membresia_anterior_id") @db.Uuid
  membresiaAnterior     Membresia?             @relation("RenovacionMembresia", fields: [membresiaAnteriorId], references: [id], onDelete: Restrict)
  renovaciones          Membresia[]            @relation("RenovacionMembresia")
  estado                EstadoMembresia        @default(PENDIENTE_PAGO)
  fechaInicioSolicitada DateTime               @map("fecha_inicio_solicitada") @db.Date
  fechaInicio           DateTime?              @map("fecha_inicio") @db.Date
  fechaVencimiento      DateTime?              @map("fecha_vencimiento") @db.Date
  registradaPorId       String                 @map("registrada_por") @db.Uuid
  registradaPor         User                   @relation(fields: [registradaPorId], references: [id])
  pagoAplicadoRef       String?                @unique @map("pago_aplicado_ref") @db.VarChar(100)
  creadoEn              DateTime               @default(now()) @map("creado_en")

  tiposClase MembresiaTipoClase[]
  reservas   Reserva[]

  @@index([miembroId, estado])
  @@map("membresia")
}

/// Tipos de clase incluidos en la membresía, copiados del plan al comprarla (H2).
model MembresiaTipoClase {
  membresiaId String    @map("membresia_id") @db.Uuid
  membresia   Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  tipoClaseId String    @map("tipo_clase_id") @db.Uuid
  tipoClase   TipoClase @relation(fields: [tipoClaseId], references: [id])

  @@id([membresiaId, tipoClaseId])
  @@map("membresia_tipo_clase")
}

/// Concepto de un cobro (Módulo 5): compra de membresía y renovación (H2) o
/// sesión adicional con un entrenador (H9).
enum ConceptoCobro {
  MEMBRESIA
  RENOVACION
  SESION_ADICIONAL

  @@map("concepto_cobro")
}

/// Tipo del registro que origina un cobro (Módulo 5).
enum ReferenciaCobro {
  MEMBRESIA
  SESION

  @@map("referencia_cobro")
}

/// Estado de un cobro (Módulo 5). Se crea PENDIENTE y pasa a PAGADO cuando
/// la pasarela aprueba un intento de pago (H12).
enum EstadoCobro {
  PENDIENTE
  PAGADO

  @@map("estado_cobro")
}

/// Cobro que el miembro paga desde su cuenta (Módulo 5). Lo crea
/// CobrosService.crearCobro() desde el módulo que origina el cobro (H2 al
/// registrar una membresía).
///
/// El monto mayor que 0 vive como CHECK en la migración. Cada registro de
/// origen tiene un solo cobro (índice único referencia_tipo + referencia_id).
model Cobro {
  id             String          @id @default(uuid()) @db.Uuid
  miembroId      String          @map("miembro_id") @db.Uuid
  miembro        Miembro         @relation(fields: [miembroId], references: [id])
  concepto       ConceptoCobro
  /// Plan de la membresía, o fecha y entrenador de la sesión (H12).
  detalle        String          @db.VarChar(150)
  monto          Decimal         @db.Decimal(10, 2)
  referenciaTipo ReferenciaCobro @map("referencia_tipo")
  referenciaId   String          @map("referencia_id") @db.Uuid
  /// Desde cuándo se puede pagar (renovaciones, supuesto S3); null = desde que se genera.
  habilitadoDesde DateTime?      @map("habilitado_desde") @db.Date
  estado         EstadoCobro     @default(PENDIENTE)
  pagadoEn       DateTime?       @map("pagado_en")
  creadoEn       DateTime        @default(now()) @map("creado_en")

  intentos    IntentoPago[]
  comprobante Comprobante?
  sesion      SesionPersonal?

  @@unique([referenciaTipo, referenciaId])
  @@index([miembroId, estado])
  @@map("cobro")
}

/// Resultado de un intento de pago en la pasarela simulada (H12).
enum ResultadoPago {
  APROBADO
  RECHAZADO
  ERROR

  @@map("resultado_pago")
}

/// Intento de pago de un cobro en la pasarela simulada (H12).
///
/// Nunca guarda el número completo de la tarjeta ni el código de seguridad:
/// solo los últimos 4 dígitos. El formato de `ultimos4` (4 dígitos) y de
/// `referencia` (PAY-AAAAMMDD-XXXXXX) viven como CHECK en la migración.
model IntentoPago {
  id         String        @id @default(uuid()) @db.Uuid
  cobroId    String        @map("cobro_id") @db.Uuid
  cobro      Cobro         @relation(fields: [cobroId], references: [id])
  resultado  ResultadoPago
  mensaje    String        @db.VarChar(100)
  ultimos4   String        @db.Char(4)
  referencia String        @unique @db.VarChar(22)
  creadoEn   DateTime      @default(now()) @map("creado_en")

  comprobante Comprobante?

  @@index([cobroId])
  @@map("intento_pago")
}

/// Comprobante de un cobro pagado (H12). Uno por cobro.
///
/// `numero` (CMP-000001) se toma de la secuencia `comprobante_numero_seq`. El
/// formato y que total = subtotal + iva viven como CHECK en la migración.
model Comprobante {
  id         String      @id @default(uuid()) @db.Uuid
  numero     String      @unique @db.VarChar(10)
  cobroId    String      @unique @map("cobro_id") @db.Uuid
  cobro      Cobro       @relation(fields: [cobroId], references: [id])
  intentoId  String      @unique @map("intento_id") @db.Uuid
  intento    IntentoPago @relation(fields: [intentoId], references: [id])
  subtotal   Decimal     @db.Decimal(10, 2)
  iva        Decimal     @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  emitidoEn  DateTime    @default(now()) @map("emitido_en")

  @@map("comprobante")
}

/// Reserva de un cupo en una clase grupal (H5, DB-5.1).
///
/// `membresiaId` es la membresía con la que se reservó: de ahí salen los
/// créditos del set (créditos − reservas CONFIRMADA de esa membresía, BE-2.4).
/// Los lugares disponibles de la clase y los créditos no se guardan: se
/// calculan contando las reservas CONFIRMADA, así que cancelar libera ambos.
///
/// Lo que Prisma no puede expresar vive en la migración:
/// - índice único parcial en (clase_id, miembro_id) cuando estado = CONFIRMADA
///   (una sola reserva activa por miembro y clase; se puede volver a reservar
///   después de cancelar, H6);
/// - CHECK: cancelada_en es nulo solo si la reserva sigue CONFIRMADA.
model Reserva {
  id          String            @id @default(uuid()) @db.Uuid
  claseId     String            @map("clase_id") @db.Uuid
  clase       Clase             @relation(fields: [claseId], references: [id])
  miembroId   String            @map("miembro_id") @db.Uuid
  miembro     Miembro           @relation(fields: [miembroId], references: [id])
  membresiaId String            @map("membresia_id") @db.Uuid
  membresia   Membresia         @relation(fields: [membresiaId], references: [id])
  estado      EstadoReserva     @default(CONFIRMADA)
  asistencia  AsistenciaReserva @default(SIN_REGISTRAR)
  creadaEn    DateTime          @default(now()) @map("creada_en")
  canceladaEn DateTime?         @map("cancelada_en")

  @@index([claseId, estado])
  @@index([miembroId, estado])
  @@index([membresiaId, estado])
  @@map("reserva")
}
