// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Roles del sistema (Módulo 0). Solo se aceptan estos cuatro valores.
enum Rol {
  MIEMBRO
  ENTRENADOR
  RECEPCION
  ADMINISTRADOR

  @@map("rol")
}

enum EstadoBloque {
  DISPONIBLE
  OCUPADO

  @@map("estado_bloque")
}

enum EstadoClase {
  PROGRAMADA
  CANCELADA

  @@map("estado_clase")
}

/// Módulo que genera un aviso (Módulo 9). SESIONES y PAGOS quedan disponibles
/// para avisos futuros.
enum ModuloOrigen {
  MEMBRESIAS
  CLASES
  SESIONES
  PAGOS

  @@map("modulo_origen")
}

/// Estado de lectura de un aviso: el servicio lo crea NO_LEIDO y pasa a LEIDO
/// cuando el miembro lo abre o marca todos como leídos (H23).
enum EstadoAviso {
  NO_LEIDO
  LEIDO

  @@map("estado_aviso")
}

/// Cuenta de acceso de cualquier persona del sistema.
///
/// Las restricciones que Prisma no puede expresar (largo mínimo del nombre y
/// del apellido, formato del teléfono) viven como CHECK en la migración.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String   @db.VarChar(50)
  apellido     String   @db.VarChar(50)
  telefono     String   @db.Char(8)
  rol          Rol      @default(MIEMBRO)
  isActive     Boolean  @default(true) @map("activo")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  miembro       Miembro?
  bloquesDisponibilidad BloqueDisponibilidad[]
  clases                Clase[]
  @@map("usuario")
}

/// Ficha de un miembro del gimnasio. Cada ficha pertenece a un único usuario.
///
/// `codigoMiembro` lo genera el servidor a partir de la secuencia
/// `miembro_codigo_seq` (MBR-000001, MBR-000002, ...). Los formatos del DUI y
/// del código se validan con CHECK en la migración.
model Miembro {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  documento     String   @unique @db.Char(10)
  codigoMiembro String   @unique @map("codigo_miembro") @db.Char(10)
  createdAt     DateTime @default(now()) @map("created_at")
  registrosProgreso RegistroProgreso[] 

  avisos Aviso[]

  @@map("miembro")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model BloqueDisponibilidad {
  id           String       @id @default(uuid()) @db.Uuid
  entrenadorId String       @map("entrenador_id") @db.Uuid
  entrenador   User         @relation(fields: [entrenadorId], references: [id])
  inicio       DateTime
  fin          DateTime
  duracionMin  Int          @map("duracion_min")
  estado       EstadoBloque @default(DISPONIBLE)
  creadoEn     DateTime     @default(now()) @map("creado_en")

  @@index([entrenadorId, inicio])
  @@map("bloque_disponibilidad")
}

model Clase {
  id           String      @id @default(uuid()) @db.Uuid
  nombre       String      @db.VarChar(80)
  entrenadorId String      @map("entrenador_id") @db.Uuid
  entrenador   User        @relation(fields: [entrenadorId], references: [id])
  inicio       DateTime
  fin          DateTime
  estado       EstadoClase @default(PROGRAMADA)
  creadoEn     DateTime    @default(now()) @map("creado_en")

  @@index([entrenadorId, inicio])
  @@map("clase")
}

/// Aviso de un miembro (Módulo 9, H22). Lo registra únicamente AvisosService;
/// no hay endpoint para crearlos.
///
/// Deduplicación: el índice único (miembro_id, referencia) impide repetir un
/// aviso con la misma referencia para el mismo miembro. Los avisos sin
/// referencia (NULL) no chocan entre sí, porque PostgreSQL trata cada NULL como
/// distinto en un índice único: se comporta como el índice parcial que pide
/// DB-22.1 sin necesitar la preview `partialIndexes`.
///
/// Las restricciones que Prisma no puede expresar (título y mensaje no vacíos,
/// estado coherente con leido_en) viven como CHECK en la migración.
model Aviso {
  id           String       @id @default(uuid()) @db.Uuid
  miembroId    String       @map("miembro_id") @db.Uuid
  miembro      Miembro      @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  titulo       String       @db.VarChar(100)
  mensaje      String       @db.VarChar(500)
  moduloOrigen ModuloOrigen @map("modulo_origen")
  referencia   String?      @db.VarChar(100)
  estado       EstadoAviso  @default(NO_LEIDO)
  creadoEn     DateTime     @default(now()) @map("creado_en")
  leidoEn      DateTime?    @map("leido_en")

  @@unique([miembroId, referencia])
  @@index([miembroId, creadoEn])
  @@index([miembroId, estado])
  @@map("aviso")
}


enum TipoProgreso {
  PESO
  CINTURA
  CADERA
  PECHO
  BRAZO
  MUSLO
  MARCA

  @@map("tipo_progreso")
}

model RegistroProgreso {
  id           String       @id @default(uuid()) @db.Uuid
  miembroId    String       @map("miembro_id") @db.Uuid
  miembro      Miembro      @relation(fields: [miembroId], references: [id], onDelete: Cascade)

  fecha        DateTime     @db.Date
  tipo         TipoProgreso
  valor        Decimal      @db.Decimal(5, 1)
  ejercicio    String?      @db.VarChar(60)
  repeticiones Int?
  creadoEn     DateTime     @default(now()) @map("creado_en")

  @@index([miembroId, fecha])
  @@map("registro_progreso")
}